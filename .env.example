# Copy to .env and fill in.
SARVAM_API_KEY=sk_xxxxxxxxxxxxxxxx

# Speech-to-text (Sarvam batch API)
STT_MODEL=saaras:v4
# transcribe | codemix | verbatim | translit | translate
STT_MODE=transcribe
# unknown = auto-detect; or hi-IN / en-IN / te-IN
STT_LANGUAGE=unknown
STT_FILES_PER_JOB=20
STT_PARALLEL_JOBS=3

# ── Judge: the model that decides errors / fatal / non-fatal (GPT-5 series via OpenRouter) ──
# OpenRouter key (sk-or-v1-...). Leave empty to fall back to Sarvam for grading.
JUDGE_API_KEY=
JUDGE_BASE_URL=https://openrouter.ai/api/v1
# GPT-5 series on OpenRouter, e.g. openai/gpt-5.4 | openai/gpt-5.4-mini (cheaper) | openai/gpt-5.5
JUDGE_MODEL=openai/gpt-5.4
# GPT-5 thinking effort: minimal | low | medium | high
JUDGE_REASONING=low

# LLM (Sarvam chat completions: test setup, simulation, root causes, fixes)
LLM_MODEL=sarvam-105b
# off (fast, recommended: sarvam-105b can spend the whole token budget thinking) | low | medium | high | max
GRADER_REASONING=off
ANALYSIS_REASONING=off
GRADER_WORKERS=4
# independent grading samples per call, majority vote (default: 1 with the judge model, 3 with Sarvam)
# GRADER_SAMPLES=1
# 1 = send the full 45k-token bot prompt with every grading call (slower, costlier)
GRADER_INCLUDE_FULL_PROMPT=0
# human review only if the call result rests entirely on findings below this confidence (or a major issue outside the audit sheet)
REVIEW_CONFIDENCE=0.5
# corrected prompt tested worse than the recording? revise and re-test up to N rounds
REFINE_MAX_ROUNDS=3

# Fix testing (simulated replay of failed calls: baseline prompt vs fixed prompt)
# local = run the prompt on Sarvam LLM with stubbed tools; samvaad = your real Sarvam agent
SIM_BACKEND=local
SIM_BOT_MODEL=sarvam-105b
SIM_BOT_REASONING=off
SIM_BUYER_MODEL=sarvam-105b
SIM_CASES_PER_FIX=4
SIM_SCENARIOS_PER_FIX=2
SIM_MAX_TURNS=14
SIM_WORKERS=4
# Only for SIM_BACKEND=samvaad (from the Sarvam agent builder)
SAMVAAD_ORG_ID=
SAMVAAD_WORKSPACE_ID=
SAMVAAD_APP_ID=
SAMVAAD_BASELINE_VERSION=
SAMVAAD_CORRECTED_VERSION=

# Paths
AUDIT_DB=data/audit.db
INBOX_DIR=data/inbox
BOT_PROMPT_PATH=prompts/vani_buyer_prompt.md
