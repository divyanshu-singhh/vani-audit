# Copy to .env and fill in.
SARVAM_API_KEY=sk_xxxxxxxxxxxxxxxx

# Speech-to-text (Sarvam batch API)
STT_MODEL=saaras:v4
# transcribe | codemix | verbatim | translit | translate
STT_MODE=transcribe
# unknown = auto-detect; or hi-IN / en-IN / te-IN
STT_LANGUAGE=unknown
STT_FILES_PER_JOB=20
STT_PARALLEL_JOBS=3

# LLM (Sarvam chat completions)
LLM_MODEL=sarvam-105b
# off (fast, recommended: sarvam-105b can spend the whole token budget thinking) | low | medium | high | max
GRADER_REASONING=off
ANALYSIS_REASONING=off
GRADER_WORKERS=4
# independent grading samples per call, majority vote (1 = fastest, 3 = stable)
GRADER_SAMPLES=3
# 1 = send the full 45k-token bot prompt with every grading call (slower, costlier)
GRADER_INCLUDE_FULL_PROMPT=0

# Fix testing (simulated replay of failed calls: baseline prompt vs fixed prompt)
# local = run the prompt on Sarvam LLM with stubbed tools; samvaad = your real Sarvam agent
SIM_BACKEND=local
SIM_BOT_MODEL=sarvam-105b
SIM_BOT_REASONING=off
SIM_BUYER_MODEL=sarvam-105b
SIM_CASES_PER_FIX=4
SIM_SCENARIOS_PER_FIX=2
SIM_MAX_TURNS=14
SIM_WORKERS=4
# Only for SIM_BACKEND=samvaad (from the Sarvam agent builder)
SAMVAAD_ORG_ID=
SAMVAAD_WORKSPACE_ID=
SAMVAAD_APP_ID=
SAMVAAD_BASELINE_VERSION=
SAMVAAD_CORRECTED_VERSION=

# Paths
AUDIT_DB=data/audit.db
INBOX_DIR=data/inbox
BOT_PROMPT_PATH=prompts/vani_buyer_prompt.md
